---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, AUTHOR } from '../consts';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Контакты — ${SITE.name}`,
  description: 'Свяжитесь со мной: Telegram, TenChat или форма обратной связи.',
  url: new URL('/contact', Astro.site).href,
  inLanguage: SITE.lang,
  mainEntity: {
    '@type': 'Person',
    name: AUTHOR.name,
    jobTitle: AUTHOR.jobTitle,
    sameAs: AUTHOR.sameAs,
  },
};
---

<BaseLayout
  title="Контакты"
  description="Свяжитесь со мной: Telegram, TenChat или форма обратной связи. Разработка сайтов, обучение, сотрудничество."
  schema={schema}
>
  <section class="contact">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Контакты' }]} />

      <h1 class="contact__title">Связаться со мной</h1>
      <p class="contact__lead">
        Отвечаю на вопросы по разработке, обучению и сотрудничеству.
      </p>

      <div class="contact__grid">
        <!-- Левая колонка: способы связи -->
        <aside class="contact__aside">
          <h2 class="contact__section-title">Способы связи</h2>

          <ul class="contact__links">
            <li>
              <a
                href={AUTHOR.contacts.telegram}
                class="contact-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="contact-link__label">Telegram</span>
                <span class="contact-link__value">@web_desigm</span>
                <span class="contact-link__hint">Самый быстрый способ</span>
              </a>
            </li>
            <li>
              <a
                href={AUTHOR.contacts.tenchat}
                class="contact-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="contact-link__label">TenChat</span>
                <span class="contact-link__value">vadimshabanov</span>
              </a>
            </li>
          </ul>

          <div class="contact__divider" aria-hidden="true"></div>

          <h2 class="contact__section-title">С чем можно обратиться</h2>

          <ul class="contact__topics">
            <li>Заказать услугу</li>
            <li>Записаться на обучение</li>
            <li>Реклама и сотрудничество</li>
          </ul>
        </aside>

        <!-- Правая колонка: форма -->
        <div class="contact__form-wrapper">


          <form
            class="contact-form"
            action="#"
            method="POST"
            data-contact-form
          >
            <!-- Имя -->
            <div class="field">
              <label for="contact-name" class="field__label">
                Имя <span class="field__required">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                class="field__input"
                required
                autocomplete="name"
              />
            </div>

            <!-- Способ связи: радиокнопки -->
            <fieldset class="field field--radio">
              <legend class="field__label">
                Способ связи <span class="field__required">*</span>
              </legend>

              <div class="radio-group">
                <label class="radio">
                  <input
                    type="radio"
                    name="contact-method"
                    value="telegram"
                    checked
                    data-method
                  />
                  <span class="radio__box"></span>
                  <span class="radio__label">Telegram</span>
                </label>

                <label class="radio">
                  <input
                    type="radio"
                    name="contact-method"
                    value="phone"
                    data-method
                  />
                  <span class="radio__box"></span>
                  <span class="radio__label">Телефон</span>
                </label>

                <label class="radio">
                  <input
                    type="radio"
                    name="contact-method"
                    value="max"
                    data-method
                  />
                  <span class="radio__box"></span>
                  <span class="radio__label">MAX</span>
                </label>
              </div>
            </fieldset>

            <!-- Условное поле под способ связи -->
            <div class="field">
              <label for="contact-value" class="field__label" data-value-label>
                Ваш ник или телефон в Telegram
              </label>
              <input
                type="text"
                id="contact-value"
                name="contact-value"
                class="field__input"
                placeholder="@username или +7..."
                required
                data-value-input
              />
            </div>

            <!-- Сообщение -->
            <div class="field">
              <label for="contact-message" class="field__label">
                Сообщение <span class="field__optional">(опционально)</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                class="field__input field__textarea"
                rows="5"
              ></textarea>
            </div>

            <!-- Согласие -->
            <label class="checkbox">
              <input
                type="checkbox"
                name="consent"
                required
                data-consent
              />
              <span class="checkbox__box"></span>
              <span class="checkbox__label">
                Согласен на обработку персональных данных
              </span>
            </label>

            <!-- Кнопка -->
            <button type="submit" class="btn contact-form__submit">
              Отправить
              <span class="btn__arrow" aria-hidden="true">→</span>
            </button>

            <p class="contact-form__note">
              Отвечу в течение 1 рабочего дня. Срочно — пишите в Telegram.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>