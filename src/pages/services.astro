---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ServicesSection from '../components/ServicesSection.astro';
import {
  SITE,
  AUTHOR,
  SERVICE_GROUPS,
  ADDITIONAL_SERVICES,
  WORK_STEPS,
  CASES,
} from '../consts';

// === FAQ — реальные вопросы-ответы ===
const faq = [
  {
    q: 'Сколько времени занимает разработка сайта?',
    a: 'Зависит от задачи. Лендинг на Tilda — 3–7 дней. Корпоративный сайт на WordPress — 2–3 недели. Интернет-магазин или курс с ЛК — от 3 до 6 недель. Точный срок фиксирую в договоре после обсуждения задачи.',
  },
  {
    q: 'Какая предоплата и как проходит оплата?',
    a: 'Предоплата 50% после подписания договора и согласования ТЗ. Остаток — после сдачи проекта. Работаю с самозанятыми/ИП, предоставляю закрывающие документы.',
  },
  {
    q: 'Что входит в стоимость?',
    a: 'Дизайн, вёрстка, адаптив под мобильные, базовое SEO (мета-теги, sitemap, robots.txt), подключение домена и SSL, обучение управлению сайтом. Полный список по каждой услуге — в блоке «Что входит» выше.',
  },
  {
    q: 'Можно ли вносить правки во время работы?',
    a: 'Да. Две итерации правок на этапе дизайна и две — на этапе вёрстки включены в стоимость. Дальнейшие правки — по договорённости или по часовой ставке.',
  },
  {
    q: 'Что если сайт нужен очень срочно?',
    a: 'Срочные проекты беру, если позволяет текущая загрузка. Срочность обычно +20–30% к стоимости. Напишите задачу и дедлайн — скажу, реально ли уложиться.',
  },
  {
    q: 'Вы поддерживаете сайт после сдачи?',
    a: 'Да. 30 дней после запуска — бесплатная поддержка: мелкие правки, консультации, помощь с админкой. Дальше — по договорённости (почасовая или месячная поддержка).',
  },
  {
    q: 'Работаете ли вы с моим городом / удалённо?',
    a: 'Работаю удалённо со всей Россией и СНГ. Созвоны — в Telegram, WhatsApp или MAX. Обмен файлами — через облако. Физическое присутствие не требуется.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Разработка сайтов',
    provider: {
      '@type': 'Person',
      name: AUTHOR.name,
      url: SITE.url,
      jobTitle: AUTHOR.jobTitle,
    },
    areaServed: {
      '@type': 'Country',
      name: 'Россия',
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Услуги разработки',
      itemListElement: SERVICE_GROUPS.flatMap((service) =>
        service.prices.map((p) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: `${service.title} — ${p.label}`,
          },
          priceCurrency: 'RUB',
          price: p.price.replace(/[^\d]/g, ''),
        }))
      ),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="Услуги — разработка сайтов на Tilda, WordPress, HTML+CSS"
  description="Разработка сайтов на Tilda, WordPress, HTML+CSS+JS. Лендинги, интернет-магазины, курсы с личными кабинетами. SEO-оптимизация. Аудит проекта — бесплатно."
  schema={schema}
>
  <!-- ============================================ -->
  <!-- ОСНОВНЫЕ УСЛУГИ                               -->
  <!-- ============================================ -->
  <section class="services">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Услуги' }]} />

      <h1 class="services__title">Услуги</h1>
      <p class="services__lead">
        Разработка сайтов под ключ: от лендинга на Tilda до интернет-магазина
        на WordPress. Прозрачные цены, чёткие сроки, поддержка после сдачи.
      </p>

      <ServicesSection variant="full" />
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ДОПОЛНИТЕЛЬНЫЕ УСЛУГИ                         -->
  <!-- ============================================ -->
  <section class="additional">
    <div class="container">
      <h2 class="additional__title">Дополнительно</h2>
      <div class="additional__grid">
        {ADDITIONAL_SERVICES.map((item) => (
          <article class="additional-card">
            <h3 class="additional-card__title">{item.title}</h3>
            <p class="additional-card__price">{item.price}</p>
            <p class="additional-card__note">{item.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ПРОЦЕСС РАБОТЫ                                -->
  <!-- ============================================ -->
  <section class="process">
    <div class="container">
      <h2 class="process__title">Как я работаю</h2>

      <ol class="process__list">
        {WORK_STEPS.map((step) => (
          <li class="process-step">
            <span class="process-step__number">{step.number}</span>
            <h3 class="process-step__title">{step.title}</h3>
            <p class="process-step__text">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

<!-- ============================================ -->
<!-- КЕЙСЫ                                        -->
<!-- ============================================ -->
<section class="cases" data-cases>
  <div class="container">
    <span class="label cases__label">Кейсы</span>

    <h2 class="cases__title">
      Реальные проекты — с задачей и результатом
    </h2>

    <div class="cases__grid">
      {CASES.map((c, i) => (
        <article class="case-card" data-case-card data-case-id={c.id} data-index={i}>
          <button
            type="button"
            class="case-card__inner"
            aria-label={`Открыть кейс: ${c.title}`}
            data-case-open={c.id}
          >
            <div class="case-card__cover">
              <img
                src={c.cover}
                alt={c.coverAlt}
                width="800"
                height="800"
                loading="lazy"
              />
              <span class="case-card__cover-placeholder" aria-hidden="true">
                [СКРИНШОТ]
              </span>
              <span class="case-card__arrow" aria-hidden="true">→</span>
            </div>

            <div class="case-card__info">
              <h3 class="case-card__title">{c.title}</h3>
              <p class="case-card__meta">
                <span>{c.stack}</span>
                <span class="case-card__dot" aria-hidden="true">·</span>
                <span>{c.year}</span>
              </p>
            </div>
          </button>
        </article>
      ))}
    </div>

    <div class="cases__footer">
      <a href="/contact" class="btn">
        Хочу так же
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

  <!-- Модалка кейса -->
  <div class="case-modal" data-case-modal hidden>
    <div class="case-modal__overlay" data-case-close></div>

    <div
      class="case-modal__content"
      role="dialog"
      aria-modal="true"
      aria-labelledby="case-modal-title"
    >
      <button
        type="button"
        class="case-modal__close"
        aria-label="Закрыть"
        data-case-close
        data-lenis-prevent
      >✕</button>

      <div class="case-modal__body" data-case-modal-body>
        {/* Содержимое генерируется JS */}
      </div>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- FAQ                                           -->
  <!-- ============================================ -->
  <section class="faq">
    <div class="container">
      <h2 class="faq__title">Частые вопросы</h2>

      <div class="faq__list">
        {faq.map((item, i) => (
          <details class="faq-item" {...(i === 0 ? { open: true } : {})}>
            <summary class="faq-item__question">
              {item.q}
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-item__answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- CTA + ФОРМА                                   -->
  <!-- ============================================ -->
  <section class="contact-cta" id="order">
    <div class="container">
      <h2 class="contact-cta__title">Не нашли нужную услугу?</h2>
      <p class="contact-cta__lead">
        Опишите задачу — предложу решение. Отвечаю в течение 1 рабочего дня.
      </p>

      <form class="contact-form" action="#" method="POST" data-contact-form>
        <input type="hidden" name="source" value="services-cta" />
        <input type="hidden" name="service" value="" data-service-field />

        <div class="field">
          <label for="order-name" class="field__label">
            Имя <span class="field__required">*</span>
          </label>
          <input type="text" id="order-name" name="name" class="field__input" required />
        </div>

        <fieldset class="field field--radio">
          <legend class="field__label">
            Способ связи <span class="field__required">*</span>
          </legend>
          <div class="radio-group">
            <label class="radio">
              <input type="radio" name="contact-method" value="telegram" checked data-method />
              <span class="radio__box"></span>
              <span class="radio__label">Telegram</span>
            </label>
            <label class="radio">
              <input type="radio" name="contact-method" value="phone" data-method />
              <span class="radio__box"></span>
              <span class="radio__label">Телефон</span>
            </label>
            <label class="radio">
              <input type="radio" name="contact-method" value="max" data-method />
              <span class="radio__box"></span>
              <span class="radio__label">MAX</span>
            </label>
          </div>
        </fieldset>

        <div class="field">
          <label for="order-contact" class="field__label" data-value-label>
            Ваш ник или телефон в Telegram
          </label>
          <input
            type="text"
            id="order-contact"
            name="contact"
            class="field__input"
            placeholder="@username или +7..."
            required
            data-value-input
          />
        </div>

        <div class="field">
          <label for="order-message" class="field__label">
            Сообщение <span class="field__optional">(опционально)</span>
          </label>
          <textarea id="order-message" name="message" class="field__input field__textarea" rows="5"></textarea>
        </div>

        <label class="checkbox">
          <input type="checkbox" name="consent" required />
          <span class="checkbox__box"></span>
          <span class="checkbox__label">Согласен на обработку персональных данных</span>
        </label>

        <button type="submit" class="btn contact-form__submit">
          Отправить
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </form>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- ПОПАП ЗАКАЗА                                  -->
  <!-- ============================================ -->
  <div class="modal" data-modal hidden>
    <div class="modal__overlay" data-modal-close></div>
    <div class="modal__content" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <button type="button" class="modal__close" aria-label="Закрыть" data-modal-close>✕</button>

      <h2 class="modal__title" id="modal-title">
        Заказать: <span data-modal-service></span>
      </h2>

      <form class="contact-form" action="#" method="POST" data-contact-form>
        <input type="hidden" name="source" value="services-modal" />
        <input type="hidden" name="service" value="" data-service-field />

        <div class="field">
          <label for="modal-name" class="field__label">
            Имя <span class="field__required">*</span>
          </label>
          <input type="text" id="modal-name" name="name" class="field__input" required />
        </div>

        <fieldset class="field field--radio">
          <legend class="field__label">
            Способ связи <span class="field__required">*</span>
          </legend>
          <div class="radio-group">
            <label class="radio">
              <input type="radio" name="contact-method" value="telegram" checked data-method />
              <span class="radio__box"></span>
              <span class="radio__label">Telegram</span>
            </label>
            <label class="radio">
              <input type="radio" name="contact-method" value="phone" data-method />
              <span class="radio__box"></span>
              <span class="radio__label">Телефон</span>
            </label>
            <label class="radio">
              <input type="radio" name="contact-method" value="max" data-method />
              <span class="radio__box"></span>
              <span class="radio__label">MAX</span>
            </label>
          </div>
        </fieldset>

        <div class="field">
          <label for="modal-contact" class="field__label" data-value-label>
            Ваш ник или телефон в Telegram
          </label>
          <input
            type="text"
            id="modal-contact"
            name="contact"
            class="field__input"
            placeholder="@username или +7..."
            required
            data-value-input
          />
        </div>

        <div class="field">
          <label for="modal-message" class="field__label">
            Сообщение <span class="field__optional">(опционально)</span>
          </label>
          <textarea id="modal-message" name="message" class="field__input field__textarea" rows="4"></textarea>
        </div>

        <label class="checkbox">
          <input type="checkbox" name="consent" required />
          <span class="checkbox__box"></span>
          <span class="checkbox__label">Согласен на обработку персональных данных</span>
        </label>

        <button type="submit" class="btn contact-form__submit">
          Отправить заявку
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </form>
    </div>
  </div>
</BaseLayout>