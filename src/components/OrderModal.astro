---
// Модалка «Заказать услугу».
// Используется на главной и на /services — единая разметка.
---

<div class="modal" data-modal hidden>
  <div class="modal__overlay" data-modal-close></div>
  <div
    class="modal__content"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
    data-lenis-prevent
  >
    <button
      type="button"
      class="modal__close"
      aria-label="Закрыть"
      data-modal-close
    >✕</button>

    <h2 class="modal__title" id="modal-title">
      Заказать: <span data-modal-service></span>
    </h2>

    <form
      class="contact-form"
      action="#"
      method="POST"
      data-contact-form
    >
      <input type="hidden" name="source" value="services-modal" />
      <input type="hidden" name="service" value="" data-service-field />

      <div class="field">
        <label for="modal-name" class="field__label">
          Имя <span class="field__required">*</span>
        </label>
        <input
          type="text"
          id="modal-name"
          name="name"
          class="field__input"
          required
          autocomplete="name"
        />
      </div>

      <fieldset class="field field--radio">
        <legend class="field__label">
          Способ связи <span class="field__required">*</span>
        </legend>
        <div class="radio-group">
          <label class="radio">
            <input type="radio" name="contact-method" value="telegram" checked data-method />
            <span class="radio__box"></span>
            <span class="radio__label">Telegram</span>
          </label>
          <label class="radio">
            <input type="radio" name="contact-method" value="phone" data-method />
            <span class="radio__box"></span>
            <span class="radio__label">Телефон</span>
          </label>
          <label class="radio">
            <input type="radio" name="contact-method" value="max" data-method />
            <span class="radio__box"></span>
            <span class="radio__label">MAX</span>
          </label>
        </div>
      </fieldset>

      <div class="field">
        <label for="modal-contact" class="field__label" data-value-label>
          Ваш ник или телефон в Telegram
        </label>
        <input
          type="text"
          id="modal-contact"
          name="contact"
          class="field__input"
          placeholder="@username или +7..."
          required
          data-value-input
        />
      </div>

      <div class="field">
        <label for="modal-message" class="field__label">
          Сообщение <span class="field__optional">(опционально)</span>
        </label>
        <textarea
          id="modal-message"
          name="message"
          class="field__input field__textarea"
          rows="4"
        ></textarea>
      </div>

      <label class="checkbox">
        <input type="checkbox" name="consent" required />
        <span class="checkbox__box"></span>
        <span class="checkbox__label">
          Согласен на обработку персональных данных
        </span>
      </label>

      <button type="submit" class="btn contact-form__submit">
        Отправить заявку
        <span class="btn__arrow" aria-hidden="true">→</span>
      </button>
    </form>
  </div>
</div>