---
import { SITE, DEFAULT_OG_IMAGE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Тип страницы для OG */
  type?: 'website' | 'article';
  /** Дата публикации (ISO), только для статей */
  publishedTime?: string;
  /** Дата обновления (ISO), только для статей */
  modifiedTime?: string;
  /** Отключить индексацию (для 404, служебных) */
  noindex?: boolean;
  /** JSON-LD разметка (объект или массив объектов) */
  schema?: object | object[];
}

const {
  title,
  description = SITE.description,
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  schema,
} = Astro.props;

// Полный title: "Заголовок | Название сайта"
// На главной не дублируем название
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;

// Абсолютный canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// Абсолютный URL картинки
const imageURL = new URL(image, Astro.site).href;

// Приводим schema к массиву
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!-- Базовые мета -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />



<!-- Title и description -->
<title>{fullTitle}</title>
<meta name="description" content={description} />

<!-- Индексация -->
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.lang === 'ru' ? 'ru_RU' : 'en_US'} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
{SITE.twitter && <meta name="twitter:creator" content={`@${SITE.twitter}`} />}

<!-- JSON-LD структурированные данные -->
{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}